# VITE_API_BASE: Base URL of the FlowLedger API gateway.
# Local dev: leave empty (uses relative /api, proxied to http://localhost:3000 by vite.config.ts).
# Real server (separate API domain): e.g.
# VITE_API_BASE="https://api.flowledger.com/api"
VITE_API_BASE=""

# Subdomain note: when this module moves to its own subdomain (e.g. admin.flowledger.com),
# change base in vite.config.ts from '/admin/' to '/' so it serves at the subdomain root.
