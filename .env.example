# ---- API Gateway ----

# SMTP (used to email OTP login codes). Copy real values into .env.
# Gmail: host smtp.gmail.com, port 587, secure false, user = your gmail,
#        pass = an App Password (requires 2-Step Verification on the account).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="FlowLedger <noreply@flowledger.app>"

# DeepSeek AI (primary engine for /ai/parse). Copy the real key into .env.
AI_API_KEY=""
AI_API_URL="https://api.deepseek.com"
AI_MODEL="deepseek-chat"

# OLLAMA_HOST: Base URL of the Ollama server (optional fallback when DeepSeek is down).
# Local network IP: http://192.168.1.9:11434
# On the real server: private URL of the GPU AI worker (e.g. http://<gpu-host>:11434).
# Ollama must be running with the qwen2.5:3b model pulled:
#   ollama serve
#   ollama pull qwen2.5:3b
OLLAMA_HOST="http://192.168.1.9:11434"

# OLLAMA_MODEL: The local Ollama model used for transaction parsing (fallback).
OLLAMA_MODEL="qwen2.5:3b"

# CORS_ORIGINS: Comma-separated list of allowed frontend origins.
# Leave empty for same-origin local dev/prod (no CORS needed).
# On the real server with separate subdomains, e.g.:
# CORS_ORIGINS="https://app.flowledger.com,https://admin.flowledger.com,https://superadmin.flowledger.com"
CORS_ORIGINS=""

# ---- Frontend modules (packages/app, packages/admin, packages/superadmin) ----
# Each module reads VITE_API_BASE at build time (see packages/<module>/.env.example).
# Locally leave empty (relative /api proxied to :3000).
# On the real server with a separate API domain, e.g.:
#   VITE_API_BASE="https://api.flowledger.com/api"
VITE_API_BASE=""
