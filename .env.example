# ---- API Gateway ----

# OLLAMA_HOST: Base URL of the local Ollama server.
# Locally: http://localhost:11434
# On the real server: private URL of the GPU AI worker (e.g. http://<gpu-host>:11434).
# Ollama must be running with the qwen2.5:3b model pulled:
#   ollama serve
#   ollama pull qwen2.5:3b
OLLAMA_HOST="http://localhost:11434"

# OLLAMA_MODEL: The local Ollama model used for transaction parsing.
OLLAMA_MODEL="qwen2.5:3b"

# CORS_ORIGINS: Comma-separated list of allowed frontend origins.
# Leave empty for same-origin local dev/prod (no CORS needed).
# On the real server with separate subdomains, e.g.:
# CORS_ORIGINS="https://app.flowledger.com,https://admin.flowledger.com,https://superadmin.flowledger.com"
CORS_ORIGINS=""

# ---- Frontend modules (packages/app, packages/admin, packages/superadmin) ----
# Each module reads VITE_API_BASE at build time (see packages/<module>/.env.example).
# Locally leave empty (relative /api proxied to :3000).
# On the real server with a separate API domain, e.g.:
#   VITE_API_BASE="https://api.flowledger.com/api"
VITE_API_BASE=""
